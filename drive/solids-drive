#!/usr/bin/python3
"""Per-user Solids Group Shared Drive authorization and mount supervisor."""
import argparse
import configparser
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET

DRIVE_ID = "0ABOlbDUzr0nyUk9PVA"
CLIENT_FILE = Path("/etc/solids-drive/client.json")
AUTH_LOCK = Path("/run/lock/solids-drive-oauth.lock")
SERVICE = "solids-drive.service"


class SetupError(Exception):
    """A user-actionable error, safe to show without exposing credentials."""


def atomic_write(path, content, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(content)
            os.fchmod(stream.fileno(), mode)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def read_client(path):
    try:
        data = json.loads(path.read_text())["installed"]
        client = {key: data[key] for key in ("client_id", "client_secret")}
        if not all(isinstance(value, str) and value and not any(
                char.isspace() for char in value) for value in client.values()):
            raise ValueError()
        if not client["client_id"].endswith(".apps.googleusercontent.com"):
            raise ValueError()
        return client
    except (OSError, ValueError, KeyError, TypeError):
        raise SetupError("Google application setup is missing or invalid. An administrator must run:\n"
                         "sudo solids-drive --install-client /path/to/downloaded-client.json") from None


def message(text):
    print(text, flush=True)
    subprocess.run(["kdialog", "--title", "Solids Group Drive", "--error", text],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def authentication_error(stderr):
    # Network outages, quota errors, and lack of Drive permission are NOT a
    # reason to discard a usable refresh token or open another browser.
    return any(marker in stderr.lower() for marker in
               ("invalid_grant", "invalid_token", "token has been expired or revoked",
                "couldn't find token", "empty token found"))


def add_bookmark(home):
    path = home / ".local/share/user-places.xbel"
    target = (home / "gdrive").as_uri()
    try:
        root = ET.fromstring(path.read_bytes()) if path.exists() else ET.Element("xbel", version="1.0")
        if any(item.get("href") == target for item in root.findall("bookmark")):
            return
        bookmark = ET.SubElement(root, "bookmark", href=target)
        ET.SubElement(bookmark, "title").text = "Solids Group"
        metadata = ET.SubElement(ET.SubElement(bookmark, "info"), "metadata",
                                 owner="http://freedesktop.org")
        ET.SubElement(metadata, "{http://www.freedesktop.org/standards/desktop-bookmarks}icon",
                      name="folder-remote")
        atomic_write(path, ET.tostring(root, encoding="unicode", xml_declaration=True))
    except (OSError, ET.ParseError):
        print("Could not add the Dolphin shortcut; the drive is available at ~/gdrive.", flush=True)


class Drive:
    def __init__(self, home, username, rclone="/usr/bin/rclone"):
        if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.@-]*\$?", username):
            raise SetupError("The Linux username is not suitable for a Drive folder name.")
        self.home, self.username, self.rclone = home, username, rclone
        self.directory = home / ".config/solids-drive"
        self.directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.directory.chmod(0o700)
        self.config = self.directory / "rclone.conf"
        self.mountpoint = home / "gdrive"
        self.cache = home / ".cache/solids-drive"
        self.child = None
        self.stopping = False

    def command(self, *args, config=None):
        return [self.rclone, "--config", str(config or self.config), *args]

    def environment(self):
        # Generic rclone environment settings must not redirect this mount to
        # another remote, config file, token, or shared drive.
        return {key: value for key, value in os.environ.items() if not key.startswith("RCLONE_")}

    def execute(self, *args, config=None, timeout=60):
        # Never print rclone's config output or OAuth diagnostics to the journal.
        with tempfile.TemporaryFile(mode="w+") as errors:
            try:
                result = subprocess.run(self.command(*args, config=config), stdin=subprocess.DEVNULL,
                                        stdout=subprocess.DEVNULL, stderr=errors, timeout=timeout,
                                        env=self.environment())
                errors.seek(0)
                return result.returncode, errors.read(65536)
            except subprocess.TimeoutExpired:
                return 1, "Request timed out"

    def parser(self):
        config = configparser.ConfigParser(interpolation=None)
        if self.config.exists():
            config.read(self.config)
        return config

    def configured(self, client):
        config = self.parser()
        if not config.has_section("solids"):
            return False
        remote = config["solids"]
        if (remote.get("type") != "drive" or remote.get("team_drive") != DRIVE_ID
                or remote.get("root_folder_id", "")):
            raise SetupError("Unexpected Drive configuration. Check ~/.config/solids-drive/rclone.conf.")
        return (bool(remote.get("token"))
                and all(remote.get(key) == value for key, value in client.items()))

    def authorize(self, client):
        print("Waiting for the browser sign-in slot. Sign in with your solids.group account.", flush=True)
        # rclone's loopback callback uses port 53682. Serialize ONLY sign-in,
        # not mounts, so simultaneous desktop users cannot steal the port.
        with AUTH_LOCK.open("rb") as lock:
            while not self.stopping:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    time.sleep(1)
            if self.stopping:
                return False
            with tempfile.TemporaryDirectory(dir=self.directory) as temporary:
                staged = Path(temporary) / "rclone.conf"
                atomic_write(staged, "[solids]\ntype = drive\nscope = drive\n"
                             f"team_drive = {DRIVE_ID}\n"
                             f"client_id = {client['client_id']}\n"
                             f"client_secret = {client['client_secret']}\n")
                status, _ = self.execute("config", "update", "solids",
                                         "config_is_local", "true", "config_change_team_drive", "false",
                                         config=staged, timeout=240)
                config = configparser.ConfigParser(interpolation=None)
                config.read(staged)
                try:
                    token = json.loads(config.get("solids", "token", fallback="{}"))
                    valid = bool(token.get("access_token") and token.get("refresh_token"))
                except (ValueError, AttributeError):
                    valid = False
                if status or not valid:
                    return False
                # Failed/cancelled authorization never replaces existing credentials.
                staged.chmod(0o600)
                os.replace(staged, self.config)
                return True

    def access(self):
        return self.execute("lsf", "solids:", "--dirs-only", "--max-depth", "1",
                            "--retries", "1", "--low-level-retries", "1",
                            "--contimeout", "10s", "--timeout", "30s")

    def prepare_mountpoint(self):
        if self.mountpoint.is_symlink() or os.path.ismount(self.mountpoint):
            raise SetupError("~/gdrive is already a mount or a symlink; it has been left untouched.")
        self.mountpoint.mkdir(mode=0o700, exist_ok=True)
        if any(self.mountpoint.iterdir()):
            raise SetupError("~/gdrive contains local files. Move them elsewhere before running solids-drive.")
        self.mountpoint.chmod(0o700)

    def mount(self):
        self.prepare_mountpoint()
        self.cache.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.cache.chmod(0o700)
        self.child = subprocess.Popen(self.command(
            "mount", "solids:", str(self.mountpoint), "--cache-dir", str(self.cache),
            "--vfs-cache-mode", "full", "--vfs-cache-max-size", "5G",
            "--vfs-cache-max-age", "24h", "--dir-cache-time", "1m", "--poll-interval", "15s",
            "--umask", "077", "--default-permissions", "--devname", "solids-group",
            "--drive-export-formats", "link.html"), stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=self.environment())
        for _ in range(60):
            if self.stopping or self.child.poll() is not None:
                return False
            if os.path.ismount(self.mountpoint):
                self.ensure_user_folder()
                add_bookmark(self.home)
                print("Solids Group Drive mounted at ~/gdrive.", flush=True)
                return True
            time.sleep(1)
        return False

    def ensure_user_folder(self):
        # Pin the mounted filesystem with a directory descriptor. If it is
        # unmounted concurrently, mkdirat fails instead of creating local files.
        fd = os.open(self.mountpoint, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            if os.fstat(fd).st_dev == self.mountpoint.parent.stat().st_dev:
                raise SetupError("Drive mount disappeared before creating the user folder.")
            try:
                os.mkdir(self.username, mode=0o700, dir_fd=fd)
            except FileExistsError:
                if not stat.S_ISDIR(os.stat(self.username, dir_fd=fd, follow_symlinks=False).st_mode):
                    raise SetupError("An existing file occupies your user folder name on the Shared Drive.") from None
        finally:
            os.close(fd)

    def stop_mount(self):
        if self.child is None:
            return
        if self.child.poll() is None:
            self.child.send_signal(signal.SIGINT)
            try:
                self.child.wait(timeout=25)
            except subprocess.TimeoutExpired:
                self.child.kill()
                self.child.wait()
        if os.path.ismount(self.mountpoint):
            subprocess.run(["fusermount3", "-u", str(self.mountpoint)],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        if not os.path.ismount(self.mountpoint) and not self.mountpoint.is_symlink():
            self.mountpoint.chmod(0o500)
        self.child = None

    def stop(self, *_):
        self.stopping = True
        # The service uses KillMode=control-group: systemd also stops an OAuth
        # subprocess immediately, even while execute() is waiting for it.

    def wait_retry(self):
        for _ in range(60):
            if self.stopping:
                break
            time.sleep(1)

    def run(self):
        client = read_client(CLIENT_FILE)
        prompted = False
        with (self.directory / "session.lock").open("a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return
            try:
                while not self.stopping:
                    if not self.configured(client):
                        if prompted:
                            return
                        prompted = True
                        if not self.authorize(client):
                            if not self.stopping:
                                message("Google sign-in was not completed. It will be offered next login; "
                                        "run solids-drive to try again now.")
                            return
                    status, error = self.access()
                    if status:
                        if authentication_error(error):
                            if prompted:
                                message("Google authorization was rejected. Run solids-drive --reauth to retry.")
                                return
                            prompted = True
                            if not self.authorize(client):
                                if not self.stopping:
                                    message("Google sign-in was not completed. It will be offered next login.")
                                return
                            continue
                        print("Drive unavailable (network, permissions, or quota); retrying in one minute.", flush=True)
                        self.wait_retry()
                        continue
                    try:
                        if self.mount():
                            while not self.stopping and self.child.poll() is None:
                                time.sleep(1)
                    finally:
                        self.stop_mount()
                    if not self.stopping:
                        print("Drive mount stopped; retrying in one minute.", flush=True)
                        self.wait_retry()
            finally:
                self.stop_mount()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--install-client", type=Path, metavar="JSON", help="Install the Google Desktop app JSON (requires sudo)")
    action.add_argument("--run", action="store_true", help=argparse.SUPPRESS)
    action.add_argument("--reauth", action="store_true", help="Sign in again, e.g. after choosing the wrong account")
    args = parser.parse_args()
    os.umask(0o077)
    if args.install_client:
        if os.geteuid() != 0:
            raise SetupError("Use sudo for --install-client.")
        client = read_client(args.install_client)
        CLIENT_FILE.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        CLIENT_FILE.parent.chmod(0o755)
        # A Desktop application's client identity is distributed to its users;
        # this contains NO user refresh tokens and does not grant Drive access.
        atomic_write(CLIENT_FILE, json.dumps({"installed": client}) + "\n", mode=0o644)
        print("Google application configured. Each user can now run solids-drive to sign in.")
        return
    if os.geteuid() == 0:
        raise SetupError("Run solids-drive as your normal desktop user, without sudo.")
    user = pwd.getpwuid(os.getuid())
    if args.run:
        drive = Drive(Path(user.pw_dir), user.pw_name)
        signal.signal(signal.SIGTERM, drive.stop)
        signal.signal(signal.SIGINT, drive.stop)
        drive.run()
    else:
        if args.reauth:
            subprocess.run(["systemctl", "--user", "stop", SERVICE], check=True)
            drive = Drive(Path(user.pw_dir), user.pw_name)
            config = drive.parser()
            if config.has_section("solids"):
                config.remove_option("solids", "token")
                import io
                stream = io.StringIO()
                config.write(stream)
                atomic_write(drive.config, stream.getvalue())
        variables = [key for key in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "XDG_CURRENT_DESKTOP") if key in os.environ]
        if variables:
            subprocess.run(["systemctl", "--user", "import-environment", *variables], check=True)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "start", SERVICE], check=True)


if __name__ == "__main__":
    try:
        main()
    except SetupError as error:
        if os.geteuid() == 0:
            print(str(error), file=sys.stderr)
        else:
            message(str(error))
        sys.exit(1)
    except (OSError, configparser.Error, subprocess.SubprocessError):
        # Config parser exceptions can contain entire lines, including tokens.
        print("Solids Group Drive could not start. Check rclone/FUSE installation, "
              "the user service, and ~/.config/solids-drive permissions.", file=sys.stderr)
        sys.exit(1)
