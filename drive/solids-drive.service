[Unit]
Description=Solids Group Shared Drive (per-user Google account)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/solids-drive --run
UMask=0077
KillMode=control-group
TimeoutStopSec=45
# Authentication cancellation is retried at next login, not in a prompt loop.
# The supervisor handles network outages and mount restarts itself.
Restart=no
