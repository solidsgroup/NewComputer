#!/bin/bash

set -Eeuo pipefail

command_name="${0##*/}"
printf '%s' "$command_name" >>"$CI_COMMAND_TRACE"
printf ' %q' "$@" >>"$CI_COMMAND_TRACE"
printf '\n' >>"$CI_COMMAND_TRACE"

if [[ "${CI_INTERRUPT_ON_COMMAND:-}" == "$command_name" ]]; then
    kill -INT "$PPID"
    exit 130
fi

case "$command_name" in
    apt-get)
        for argument in "$@"; do
            if [[ "$argument" == inkscape ]]; then
                install -d /usr/share/applications
                cat > /usr/share/applications/org.inkscape.Inkscape.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Inkscape
Exec=inkscape %F
Actions=new-window;
[Desktop Action new-window]
Name=New Window
Exec=inkscape
EOF
            fi
            if [[ "$argument" == /tmp/slack-desktop.*.deb ]]; then
                install -Dm644 /dev/null /usr/lib/slack/resources/app.asar
            fi
        done
        if [[ "${CI_VALIDATE_APT:-0}" == "1" ]]; then
            for argument in "$@"; do
                # The workflow already refreshed the real indexes. Repository
                # package operations go through APT's dependency simulation.
                if [[ "$argument" == "update" ]]; then
                    exit 0
                fi

                # curl creates empty stand-ins for the desktop .deb files. The
                # workflow checks the real download URL separately, so record
                # this install without asking APT to parse the placeholder.
                if [[ "$argument" == /tmp/google-chrome-stable.*.deb || "$argument" == /tmp/slack-desktop.*.deb ]]; then
                    exit 0
                fi
            done
            /usr/bin/apt-get --simulate "$@"
        fi
        ;;
    apt-cache)
        if [[ "${CI_VALIDATE_APT:-0}" == "1" ]]; then
            /usr/bin/apt-cache "$@"
        else
            # Unit tests may skip real package-index validation.
            exit 0
        fi
        ;;
    debconf-set-selections)
        # Consume the preseed data supplied on stdin.
        cat >/dev/null
        ;;
    curl)
        output_file=""
        request_url=""
        while (( $# > 0 )); do
            if [[ "$1" == "--output" ]]; then
                output_file="$2"
                shift 2
            elif [[ "$1" == http://* || "$1" == https://* ]]; then
                request_url="$1"
                shift
            else
                shift
            fi
        done
        if [[ -n "$output_file" && \
              "$request_url" =~ /v([0-9]+\.[0-9]+\.[0-9]+)/visit([0-9]+_[0-9]+_[0-9]+)\.linux-x86_64-ubuntu24\.tar\.gz$ ]]; then
            version="${BASH_REMATCH[1]}"
            version_with_underscores="${BASH_REMATCH[2]}"
            distribution="visit${version_with_underscores}.linux-x86_64"
            archive_source="$(mktemp -d)"

            mkdir -p \
                "$archive_source/$distribution/bin" \
                "$archive_source/$distribution/data" \
                "$archive_source/$distribution/$version/bin" \
                "$archive_source/$distribution/$version/linux-x86_64/bin"
            printf '#!/bin/sh\nexit 0\n' \
                >"$archive_source/$distribution/bin/frontendlauncher"
            printf '# Synthetic CI launcher.\n' \
                >"$archive_source/$distribution/bin/frontendlauncher.py"
            printf '#!/bin/sh\nexit 0\n' \
                >"$archive_source/$distribution/$version/bin/internallauncher"
            printf '#!/bin/sh\nexit 0\n' \
                >"$archive_source/$distribution/$version/linux-x86_64/bin/engine_ser"
            chmod 755 \
                "$archive_source/$distribution/bin/frontendlauncher" \
                "$archive_source/$distribution/$version/bin/internallauncher" \
                "$archive_source/$distribution/$version/linux-x86_64/bin/engine_ser"
            /usr/bin/tar -czf "$output_file" \
                -C "$archive_source" "$distribution"
            rm -rf -- "$archive_source"
        elif [[ -n "$output_file" ]]; then
            : >"$output_file"
        fi
        ;;
    dpkg-deb)
        case "${3:-}" in
            Package)
                if [[ "$2" == /tmp/slack-desktop.*.deb ]]; then
                    printf '%s\n' slack-desktop
                else
                    printf '%s\n' google-chrome-stable
                fi
                ;;
            Version)
                printf '%s\n' 1.2.3-test
                ;;
            Architecture)
                printf '%s\n' amd64
                ;;
            *)
                exit 1
                ;;
        esac
        ;;
    dpkg-query)
        if [[ "${!#}" == google-chrome-stable && "${CI_GOOGLE_CHROME_INSTALLED:-0}" == "1" ]] ||
           [[ "${!#}" == slack-desktop && "${CI_SLACK_INSTALLED:-0}" == "1" ]]; then
            printf '%s\n' installed
            exit 0
        fi
        exit 1
        ;;
    ln)
        destination="${!#}"
        case "$destination" in
            /opt/visit/*|/usr/local/bin/visit*)
                /usr/bin/ln "$@"
                ;;
        esac
        ;;
    sha256sum)
        # The test archive is synthetic; production verifies LLNL's published
        # digest before extracting anything.
        cat >/dev/null
        ;;
esac

exit 0
